<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GojoRoot Condition="'$(GojoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\Gojo</GojoRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(GojoRoot)/experiments/quickDraw/QuickDraw.csproj" />
    <!-- Reuse the existing archive readers for profiling, without replacing a
         converter binary that may currently be processing the user's dataset. -->
    <Compile Include="../native/*.cs" Exclude="../native/Program.cs" Link="Archive/%(Filename)%(Extension)" />
    <Compile Include="../shared/JointGraph.cs" Link="Reads/JointGraph.cs" />
  </ItemGroup>
</Project>
